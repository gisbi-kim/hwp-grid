     ///
     /// 걸친 행 중 하나라도 `row_span==1` 선언이 없으면(미지 행) 기존 분배 규칙이
     /// 담당하므로 0 을 돌려준다. 반환 벡터의 길이는 `row_count` 다.
+    /// Trust a complete, internally consistent stored micro-grid. Empty cells in
+    /// a vertically subdivided row do not each require a full font-sized line.
+    pub fn coherent_stored_row_heights(&self) -> Option<Vec<HwpUnit>> {
+        let n = self.row_count as usize;
+        if n < 2 || !self.common.treat_as_char || self.cell_spacing != 0
+            || !self.local_resize_cols.is_empty() { return None; }
+        let mut rows = vec![0; n];
+        for cell in &self.cells {
+            let r = cell.row as usize;
+            if r >= n || cell.height == 0 || cell.height >= 0x80000000 { return None; }
+            if cell.row_span == 1 { rows[r] = rows[r].max(cell.height); }
+            for p in &cell.paragraphs {
+                if !p.controls.is_empty() { return None; }
+                if p.text.chars().any(|c| c > '\u{001f}') {
+                    if p.line_segs.is_empty() { return None; }
+                    for line in &p.line_segs {
+                        if line.tag & 0x80000000 != 0 || line.vertical_pos < 0
+                            || line.vertical_pos.saturating_add(line.line_height) as u32 > cell.height.saturating_add(2) { return None; }
+                    }
+                }
+            }
+        }
+        if rows.contains(&0) { return None; }
+        let sum: u64 = rows.iter().map(|&v| v as u64).sum();
+        if sum.abs_diff(self.common.height as u64) > 2 { return None; }
+        for cell in &self.cells {
+            let r = cell.row as usize;
+            let end = r + cell.row_span as usize;
+            if end > n || end <= r { return None; }
+            let span: u64 = rows[r..end].iter().map(|&v| v as u64).sum();
+            if span.abs_diff(cell.height as u64) > 2 { return None; }
+        }
+        Some(rows)
+    }
+
